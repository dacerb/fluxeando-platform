{
  "name": "@cashflow/desktop",
  "private": true,
  "version": "0.2.2",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"cd ../../services/cashflow-api && go run ./cmd/api\" \"wait-on http://127.0.0.1:5173 && tsc -p tsconfig.main.json && cross-env CASHFLOW_API_URL=http://127.0.0.1:8787 electron .\"",
    "web": "node ../../scripts/web-dev.mjs",
    "build": "vite build && tsc -p tsconfig.main.json",
    "package": "node ../../scripts/build-backend.mjs all && pnpm run build && electron-builder",
    "package:mac": "node ../../scripts/build-backend.mjs mac-arm64 && pnpm run build && electron-builder --mac dmg --arm64",
    "package:win": "node ../../scripts/build-backend.mjs win-x64 && pnpm run build && electron-builder --win nsis --x64",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dayjs": "^1.11.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cashflow.desktop",
    "productName": "CashFlow",
    "files": [
      "dist/main.js",
      "dist/preload.js",
      "renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${os}-${arch}",
        "to": "cashflow-api"
      },
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
