{
  "name": "cashflow-desktop",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @cashflow/desktop dev",
    "build": "pnpm --filter @cashflow/desktop build",
    "clean:workspace": "node scripts/clean-workspace.mjs",
    "rebuild:clean": "node scripts/clean-workspace.mjs && corepack pnpm install --force && corepack pnpm build",
    "test": "cd services/cashflow-api && go test ./...",
    "lint": "pnpm --filter @cashflow/desktop lint"
  },
  "devDependencies": { "pnpm": "^9.15.0" }
}
