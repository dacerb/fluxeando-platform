DOMAIN=fluxeando.example.com
CERTBOT_EMAIL=admin@example.com
MYSQL_DATABASE=fluxeando
MYSQL_USER=fluxeando_app
# Hora local (HH:MM) del backup lógico diario de MySQL.
BACKUP_TIME=02:30
# Se eliminan respaldos con más días que este valor.
BACKUP_RETENTION_DAYS=30
# Zona horaria IANA usada por el programador de backups.
TZ=America/Argentina/Buenos_Aires
